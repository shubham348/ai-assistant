# Comma-separated provider/model entries.
# Examples:
# AI_MODELS=ollama:qwen2.5:3b
# AI_MODELS=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile
AI_MODELS=ollama:qwen2.5:3b

# Must match one entry in AI_MODELS.
AI_DEFAULT_MODEL=ollama:qwen2.5:3b

# Optional fallback used by the basic Ollama reply function.
OLLAMA_MODEL=qwen2.5:3b

# Add the key only for providers you use.
GEMINI_API_KEY=
GROQ_API_KEY=
